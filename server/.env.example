# Copiar a server/.env y ajustar. server/.env está en .gitignore.
MQTT_HOST=localhost
MQTT_PORT=1883
# Los nombres de topic estan definidos en CHANNELS, dentro de mqtt_logger.py,
# junto con las columnas de cada CSV. Aqui solo se ajusta un prefijo opcional,
# necesario unicamente al probar contra un broker publico (donde "fridge/..."
# se cruzaria con otros usuarios). Debe coincidir con el prefijo que use el
# nodo en device/secrets.h. Vacio = topics tal cual, que es lo normal en la
# Raspberry Pi.
MQTT_TOPIC_PREFIX=
# Vacíos si el broker no exige autenticación (red local de laboratorio)
MQTT_USER=
MQTT_PASSWORD=
DATA_DIR=server/data
