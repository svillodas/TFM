\newcommand\course[1]{\renewcommand\@course{\textocourse\ #1}}
\newcommand\@course{}

\NewDocumentCommand{\processadvisor}{ >{ \SplitList {,} } m }
  {
    \ProcessList {#1} \\ 
  }

\newcommand\advisor[1]{\renewcommand\@advisor{\processadvisor{#1}}}
\newcommand\@advisor{}

\renewcommand*{\maketitle}{%
    \begingroup
    \thispagestyle{empty}
    \addtocounter{page}{-1}
    \Large
    \sffamily    
    
    \begin{center}
      \begin{minipage}{0.32\linewidth}
        \centering
        \includegraphics[width=\linewidth]{logo_uvigo}
      \end{minipage}
      \hspace{0.025\textwidth}
      \begin{minipage}{0.42\linewidth}
        \centering
        \includegraphics[width=\linewidth]{logo_udc}
      \end{minipage}
      \hspace{0.025\textwidth}
      \begin{minipage}{0.16\linewidth}
        \centering
        \includegraphics[width=\linewidth]{logo_usc}
      \end{minipage}
    \end{center}
    
    \vfill
    
    \begin{center}
        {\huge \centering \textbf \@title}
    \end{center}
    \vspace*{1cm}
    \centerline{{\huge \@author}}

    \vfill
    
    \begin{center}
    {\large
      \master \\
      \vspace*{1cm}
      \school
    }
    \end{center}

    \vfill

    \begin{center}{
        \textoadvisor: \@advisor
    }
    \end{center}

    \vfill

    \centerline{\normalsize \selectfont \@course}
    
    \normalfont
    \endgroup
}
  
