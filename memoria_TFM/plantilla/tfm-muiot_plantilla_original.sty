\newcommand\dedication[1]{%
    \thispagestyle{empty}
    \addtocounter{page}{-1}
    \vspace*{2cm}
    \begin{flushright}
     \emph{#1}
    \end{flushright}
}

% **************************************************
% * Táboa de contidos
