// Plantilla de credenciales. Copiar a secrets.h y rellenar.
//   cp device/secrets.h.example device/secrets.h
// secrets.h está en .gitignore: no se versiona nunca.
#pragma once

#define WIFI_SSID     "TU_RED_WIFI"      // Red 2.4 GHz (el ESP32 no soporta 5 GHz)
#define WIFI_PASSWORD "TU_CLAVE_WIFI"
#define MQTT_SERVER   "192.168.1.100"    // IP de la Raspberry Pi con Mosquitto
#define MQTT_PORT     1883

// Prefijo opcional de los topics, con la barra final incluida.
// Déjalo vacío en la red local. Solo hace falta contra un broker público,
// donde "fridge/..." es demasiado genérico y se cruzaría con otros usuarios.
// Debe coincidir con MQTT_TOPIC_PREFIX de server/.env.
//   Vacío  -> fridge/sensors, fridge/vibration
//   "tfm/" -> tfm/fridge/sensors, tfm/fridge/vibration
#define MQTT_TOPIC_PREFIX ""
